FROM python:3.13-slim

WORKDIR /app

# Install Python packages
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

COPY VERSION .
COPY deploy/sitecustomize.py ./sitecustomize.py
COPY deploy/worker/health.py /app/health.py
COPY deploy/worker/start.sh /app/start.sh
